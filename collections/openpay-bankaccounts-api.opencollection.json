          },
          "http": {
            "method": "POST",
            "url": "https://api.openpay.mx/v1/:merchant_id/customers/:customer_id/bankaccounts",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "The merchant identifier that scopes all resources."
