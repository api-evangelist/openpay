{
  "opencollection": "1.0.0",
  "info": {
    "name": "Openpay BankAccounts Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registered webhooks.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openpay.mx/v1/:merchant_id/webhooks",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "The merchant identifier that scopes all resources."
              }
            ]
          },
          "docs": "List registered webhooks."
        },
        {
          "info": {
            "name": "Register a webhook endpoint.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openpay.mx/v1/:merchant_id/webhooks",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "The merchant identifier that scopes all resources."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a webhook endpoint."
        },
        {
          "info": {
            "name": "Get a webhook by id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openpay.mx/v1/:merchant_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "The merchant identifier that scopes all resources."
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a webhook by id."
        },
        {
          "info": {
            "name": "Delete a webhook.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.openpay.mx/v1/:merchant_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "The merchant identifier that scopes all resources."
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a webhook."
        }
      ]
    }
  ],
  "bundled": true
}